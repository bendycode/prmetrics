#!/usr/bin/env bash
set -e

# The app is named on every heroku call and pushed to by URL, so any clone can
# deploy without a heroku git remote or a heroku.remote setting.
APP="${HEROKU_APP:-prmetrics-production}"
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
ROLLBACK_BLOCKER=""
NOTHING_TO_ROLL_BACK_TO=""
APP_URL=""

echo "🚀 Starting deployment of $APP to Heroku..."

# Check if we're in the right directory
if [ ! -f "Gemfile" ]; then
  echo "❌ Error: Must be run from the Rails root directory"
  exit 1
fi

# Ask before going on, or stop when no terminal can answer, so a deploy run by
# a script never reads its answer from whatever stdin happens to hold.
confirm() {
  if [ ! -t 0 ]; then
    echo "🛑 Deployment cancelled: stdin is not a terminal, so nobody can answer"
    exit 1
  fi
  echo "Do you want to continue? (y/N)"
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    echo "🛑 Deployment cancelled"
    exit 1
  fi
}

# Prints four fields from the app's releases: the current release's version,
# the 8-character commit it serves, the status of the newest "Deploy <sha8>"
# release for the commit given as $1 (or "none"), and the newest succeeded
# such release's version (or "none"). A config change serves the code of the
# succeeded release before it, and "Rollback to vN" serves vN's code.
release_info() {
  heroku releases -a "$APP" -n 100 --json | python3 -c '
import json, sys

sha8 = sys.argv[1]
releases = sorted(json.load(sys.stdin), key=lambda r: r["version"], reverse=True)
by_version = {r["version"]: r for r in releases}

def serving(release, depth=0):
    if release is None or depth > 50:
        return "unknown"
    description = release["description"]
    if description.startswith("Deploy "):
        return description.split()[1][:8]
    if description.startswith("Rollback to v"):
        return serving(by_version.get(int(description.split("v")[1].split()[0])), depth + 1)
    older = [r for r in releases if r["version"] < release["version"] and r["status"] == "succeeded"]
    return serving(older[0] if older else None, depth + 1)

current = next((r for r in releases if r.get("current")), None)
mine = [r for r in releases if r["description"].startswith("Deploy " + sha8)]
print(current["version"] if current else "unknown", serving(current),
      mine[0]["status"] if mine else "none",
      next((r["version"] for r in mine if r["status"] == "succeeded"), "none"))
' "$1"
}

# Sets HEALTH_RESPONSE and returns 0 when the health endpoint answers ok.
health_ok() {
  HEALTH_RESPONSE=$(curl -sf "${APP_URL}/health" 2>&1 || true)
  echo "$HEALTH_RESPONSE" | grep -q '"status":"ok"'
}

# A check failed after the new release went live. Roll back to the release
# that was live before, unless the release added schema or data migrations,
# which a rollback does not reverse.
fail_after_release() {
  echo ""
  echo "❌ DEPLOYMENT FAILED: $1"
  if [ -n "$ROLLBACK_BLOCKER" ]; then
    echo "⚠️  Not rolling back: $ROLLBACK_BLOCKER"
    if [ -z "$NOTHING_TO_ROLL_BACK_TO" ]; then
      echo "   To roll back by hand: heroku rollback v$PREVIOUS_VERSION -a $APP"
    fi
    exit 1
  fi
  echo "⏪ Rolling back to v$PREVIOUS_VERSION..."
  # A non-zero exit can follow a rollback Heroku has already made, so the
  # releases are read afterwards either way.
  if ! heroku rollback "v$PREVIOUS_VERSION" -a "$APP"; then
    echo "⚠️  heroku rollback exited non-zero; reading which release serves now"
  fi
  sleep 15
  heroku ps -a "$APP" 2>&1 || true
  if [ -n "$APP_URL" ]; then
    if health_ok; then
      echo "✅ Health check after the rollback passed: $HEALTH_RESPONSE"
    else
      echo "❌ Health check after the rollback did not return ok: $HEALTH_RESPONSE"
    fi
  fi
  if ! ROLLED=$(release_info "$SHA8"); then
    echo "⚠️  Could not read the releases after the rollback. Read: heroku releases -a $APP"
    exit 1
  fi
  read -r ROLLED_VERSION ROLLED8 _ _ <<< "$ROLLED"
  if [ "$ROLLED_VERSION" = "unknown" ]; then
    echo "⚠️  Could not read the releases after the rollback: none is marked current. Read: heroku releases -a $APP"
  elif [ "$ROLLED8" = "$LIVE8" ]; then
    echo "⏪ Rolled back: v$ROLLED_VERSION serves $ROLLED8"
  else
    echo "❌ ROLLBACK DID NOT TAKE: v$ROLLED_VERSION serves $ROLLED8, not $LIVE8. Read: heroku releases -a $APP"
  fi
  exit 1
}

# Check for uncommitted changes. diff-index reads the index's cached file
# stats, so refresh it first or a file rewritten with identical content
# (bundle install and Gemfile.lock) reads as changed. The refresh exits
# non-zero when real changes exist, which set -e must not treat as fatal.
git update-index -q --refresh || true
if ! git diff-index --quiet HEAD --; then
  echo "⚠️  Warning: You have uncommitted changes"
  confirm
fi

# Get current branch
CURRENT_BRANCH=$(git branch --show-current)
echo "📌 Current branch: $CURRENT_BRANCH"

# Verify if pushing from non-main branch is intended
if [ "$CURRENT_BRANCH" != "main" ]; then
  echo "⚠️  Warning: You are deploying from branch '$CURRENT_BRANCH' instead of 'main'"
  echo "This will deploy $CURRENT_BRANCH to production."
  confirm
fi

SHA=$(git rev-parse HEAD)
SHA8=${SHA:0:8}

# Deploy what the default branch holds, read fresh from GitHub
git fetch -q origin main || echo "⚠️  Warning: could not fetch origin main"
if [ "$(git rev-parse origin/main)" != "$SHA" ]; then
  echo "⚠️  Warning: HEAD $SHA8 is not origin/main"
  confirm
fi

# Note what is live before the push: the release to roll back to, and the
# commit it serves, against which this deploy's added migrations are found.
if ! RELEASES_BEFORE=$(release_info "$SHA8"); then
  echo "❌ Error: could not read the releases of $APP"
  exit 1
fi
read -r PREVIOUS_VERSION LIVE8 _ _ <<< "$RELEASES_BEFORE"
if [ "$PREVIOUS_VERSION" = "unknown" ]; then
  echo "❌ Error: no release of $APP is marked current, so there is no release to roll back to"
  exit 1
fi
echo "📌 Live before the deploy: v$PREVIOUS_VERSION, serving $LIVE8"
if [ "$LIVE8" = "$SHA8" ]; then
  ROLLBACK_BLOCKER="$SHA8 was already live, so the release before it runs the same code"
  NOTHING_TO_ROLL_BACK_TO=1
elif LIVE=$(git rev-parse --verify -q "$LIVE8^{commit}"); then
  ADDED_MIGRATIONS=$(git diff --name-only --no-renames --diff-filter=A "$LIVE" HEAD -- db/migrate db/data)
  if [ -n "$ADDED_MIGRATIONS" ]; then
    ROLLBACK_BLOCKER="this release adds migrations, which a rollback does not reverse: $(echo $ADDED_MIGRATIONS)"
  fi
  echo "📦 Commits this deploy ships:"
  git log --oneline --no-merges "$LIVE..HEAD"
else
  ROLLBACK_BLOCKER="the live commit $LIVE8 is not in this clone, so added migrations cannot be ruled out"
fi

# Push to Heroku. The Procfile's release command runs schema and data
# migrations before the new release goes live.
echo "📤 Pushing $SHA to Heroku..."
# A push can exit non-zero after Heroku has made the release (a dropped
# connection during a long release command), so the release check below runs
# either way and decides.
if ! git push "https://git.heroku.com/$APP.git" HEAD:main; then
  echo "⚠️  git push exited non-zero; checking the release anyway"
fi

# A release command that fails leaves the old release serving, so confirm the
# current release serves this commit. Until it does, nothing of this deploy is
# live and there is nothing to roll back.
echo "🏷️  Checking the release..."
if ! RELEASES_AFTER=$(release_info "$SHA8"); then
  echo "❌ DEPLOYMENT FAILED: could not read the releases of $APP"
  exit 1
fi
read -r CURRENT_VERSION SERVING8 MINE_STATUS MINE_SUCCEEDED <<< "$RELEASES_AFTER"
if [ "$SERVING8" != "$SHA8" ]; then
  if [ "$MINE_STATUS" = "failed" ]; then
    echo "❌ DEPLOYMENT FAILED: the release command failed for $SHA8"
    echo "   Read its output: heroku releases:output -a $APP"
    echo "   Heroku now holds this commit, so to retry, push a new commit"
  elif [ "$MINE_SUCCEEDED" != "none" ] && [ "$CURRENT_VERSION" = "$PREVIOUS_VERSION" ]; then
    echo "❌ DEPLOYMENT FAILED: Heroku already held $SHA8, so the push made no new release"
    echo "   v$CURRENT_VERSION serves $SERVING8. To serve $SHA8 again: heroku rollback v$MINE_SUCCEEDED -a $APP"
  else
    echo "❌ DEPLOYMENT FAILED: the current release v$CURRENT_VERSION runs $SERVING8, not $SHA8"
  fi
  exit 1
fi
echo "   v$CURRENT_VERSION serves $SHA8"

# Confirm the release command left no migration pending
echo "✅ Checking migration status..."
if ! MIGRATION_STATUS=$(heroku run -x --no-tty -a "$APP" -- rails db:migrate:status:with_data 2>&1); then
  echo "$MIGRATION_STATUS" | tail -20
  fail_after_release "the migration status could not be read"
fi
echo "$MIGRATION_STATUS" | tail -20
if echo "$MIGRATION_STATUS" | grep -qE '^[[:space:]]+down[[:space:]]'; then
  fail_after_release "a migration is still down after the release"
fi

# The integrity checks read the data as a whole, which a running sync can leave
# briefly inconsistent, so a failure is reported and does not fail the deploy.
echo "🔍 Running data integrity checks..."
if heroku run -x --no-tty -a "$APP" -- rake ci:data_integrity; then
  echo "✅ Data integrity checks passed"
else
  echo "⚠️  Warning: data integrity issues detected - check the output above"
fi

# Restart to ensure all changes take effect
echo "🔄 Restarting app..."
heroku restart -a "$APP" || fail_after_release "the restart failed"

# Wait for dynos to settle after restart
echo "⏳ Waiting for dynos to start..."
sleep 15

fail_if_crashed() {
  CRASHED_DYNOS=$(echo "$DYNO_STATUS" | grep -c "crashed" || true)
  if [ "$CRASHED_DYNOS" -gt 0 ]; then
    echo ""
    echo "📋 Recent logs:"
    heroku logs -n 100 -a "$APP" || true
    fail_after_release "$CRASHED_DYNOS dyno(s) crashed after restart"
  fi
}

# Check that dynos reached 'up' state
echo "🏥 Checking dyno status..."
DYNO_STATUS=$(heroku ps -a "$APP" 2>&1 || true)
echo "$DYNO_STATUS"
fail_if_crashed

STARTING_DYNOS=$(echo "$DYNO_STATUS" | grep -c "starting" || true)
if [ "$STARTING_DYNOS" -gt 0 ]; then
  echo "⏳ Some dynos still starting, waiting another 15 seconds..."
  sleep 15
  DYNO_STATUS=$(heroku ps -a "$APP" 2>&1 || true)
  echo "$DYNO_STATUS"
  fail_if_crashed
fi

# Hit the health endpoint to verify the app is actually serving requests
APP_URL=$(heroku info --json -a "$APP" 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['app']['web_url'].rstrip('/'))" 2>/dev/null || echo "")
if [ -z "$APP_URL" ]; then
  fail_after_release "could not determine the app URL for the health check"
fi
echo "🔍 Checking health endpoint..."
if health_ok; then
  echo "✅ Health check passed: $HEALTH_RESPONSE"
else
  fail_after_release "health check did not return ok: $HEALTH_RESPONSE"
fi

# The health check pings Redis from the web process; run one real job through
# the worker as well.
if ! HEROKU_APP="$APP" "$BIN_DIR/post-deploy-sync-check"; then
  fail_after_release "the post-deploy sync check failed"
fi

echo ""
echo "✅ Deployment complete!"
echo ""
echo "📊 View logs: heroku logs --tail -a $APP"
