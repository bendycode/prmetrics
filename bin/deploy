#!/usr/bin/env bash
set -e

echo "🚀 Starting deployment to Heroku..."

# Check if we're in the right directory
if [ ! -f "Gemfile" ]; then
  echo "❌ Error: Must be run from the Rails root directory"
  exit 1
fi

# Check for uncommitted changes
if ! git diff-index --quiet HEAD --; then
  echo "⚠️  Warning: You have uncommitted changes"
  echo "Do you want to continue? (y/N)"
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    echo "🛑 Deployment cancelled"
    exit 1
  fi
fi

# Get current branch
CURRENT_BRANCH=$(git branch --show-current)
echo "📌 Current branch: $CURRENT_BRANCH"

# Verify if pushing from non-main branch is intended
if [ "$CURRENT_BRANCH" != "main" ]; then
  echo "⚠️  Warning: You are deploying from branch '$CURRENT_BRANCH' instead of 'main'"
  echo "This will deploy $CURRENT_BRANCH to production."
  echo "Are you sure you want to continue? (y/N)"
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    echo "🛑 Deployment cancelled"
    exit 1
  fi
fi

# Push to Heroku
echo "📤 Pushing to Heroku..."
git push heroku $CURRENT_BRANCH:main

# Run migrations
echo "🗄️  Running database migrations..."
heroku run rails db:migrate

# Run data migrations
echo "📊 Running data migrations..."
heroku run rails db:migrate:with_data

# Check migration status
echo "✅ Checking migration status..."
heroku run rails db:migrate:status | tail -20

# Run data integrity checks
echo "🔍 Running data integrity checks..."
if heroku run rake ci:data_integrity; then
  echo "✅ Data integrity checks passed"
else
  echo "⚠️  Data integrity issues detected - check Heroku logs for details"
fi

# Restart to ensure all changes take effect
echo "🔄 Restarting app..."
heroku restart

# Wait for dynos to settle after restart
echo "⏳ Waiting for dynos to start..."
sleep 15

# Check that dynos reached 'up' state
echo "🏥 Checking dyno status..."
DYNO_STATUS=$(heroku ps 2>&1)
echo "$DYNO_STATUS"

CRASHED_DYNOS=$(echo "$DYNO_STATUS" | grep -c "crashed" || true)
if [ "$CRASHED_DYNOS" -gt 0 ]; then
  echo ""
  echo "❌ DEPLOYMENT FAILED: $CRASHED_DYNOS dyno(s) crashed after restart!"
  echo ""
  echo "📋 Recent logs:"
  heroku logs -n 100
  echo ""
  echo "⚠️  The app may be down. Check logs and consider rolling back:"
  echo "   heroku rollback"
  exit 1
fi

STARTING_DYNOS=$(echo "$DYNO_STATUS" | grep -c "starting" || true)
if [ "$STARTING_DYNOS" -gt 0 ]; then
  echo "⏳ Some dynos still starting, waiting another 15 seconds..."
  sleep 15
  DYNO_STATUS=$(heroku ps 2>&1)
  echo "$DYNO_STATUS"

  CRASHED_DYNOS=$(echo "$DYNO_STATUS" | grep -c "crashed" || true)
  if [ "$CRASHED_DYNOS" -gt 0 ]; then
    echo ""
    echo "❌ DEPLOYMENT FAILED: $CRASHED_DYNOS dyno(s) crashed after restart!"
    echo ""
    echo "📋 Recent logs:"
    heroku logs -n 100
    echo ""
    echo "⚠️  The app may be down. Check logs and consider rolling back:"
    echo "   heroku rollback"
    exit 1
  fi
fi

# Hit the health endpoint to verify the app is actually serving requests
APP_URL=$(heroku info --json 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['app']['web_url'].rstrip('/'))" 2>/dev/null || echo "")
if [ -n "$APP_URL" ]; then
  echo "🔍 Checking health endpoint..."
  HEALTH_RESPONSE=$(curl -sf "${APP_URL}/health" 2>&1 || true)
  if echo "$HEALTH_RESPONSE" | grep -q '"status":"ok"'; then
    echo "✅ Health check passed: $HEALTH_RESPONSE"
  else
    echo "⚠️  Health check did not return ok: $HEALTH_RESPONSE"
    echo "   The app may still be starting up. Check manually:"
    echo "   curl ${APP_URL}/health"
  fi
else
  echo "⚠️  Could not determine app URL for health check"
fi

echo ""
echo "✅ Deployment complete!"
echo ""
echo "📊 View logs: heroku logs --tail"
echo "🚦 Check status: heroku ps"