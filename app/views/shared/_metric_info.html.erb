<%
  definitions = metric_definitions(*keys)
  popover_body = safe_join(definitions.map { |d|
    tag.div(class: 'metric-definition mb-2') do
      tag.h6(d[:title], class: 'mb-1') + tag.p(d[:body], class: 'mb-0 small')
    end
  })
%>
<%= tag.button(
      type: 'button',
      class: 'btn btn-link p-0 ml-2 align-baseline metric-info-trigger',
      data: {
        toggle: 'popover',
        html: 'true',
        trigger: 'focus',
        placement: 'bottom',
        title: chart_label,
        content: popover_body
      },
      aria: { label: "#{chart_label} metric definitions" }
    ) do %>
  <i class="fas fa-info-circle text-info" aria-hidden="true"></i>
<% end %>
