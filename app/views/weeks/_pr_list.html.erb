<h3><%= category.titleize %> PRs</h3>
<table class="table">
  <thead>
    <tr>
      <th>Number</th>
      <th>Author</th>
      <th>Title</th>
      <th>State</th>
      <th>Created</th>
      <th>Review Ready</th>
      <th>First Feedback</th>
      <th>Time to Feedback</th>
      <th>Approved</th>
      <th>Time to Approval</th>
      <th>Merged</th>
      <th>Time to Merge</th>
      <th>Cancelled</th>
    </tr>
  </thead>
  <tbody>
    <% prs.each do |pr| %>
      <tr>
        <td><%= link_to "##{pr.number}", github_pr_url(pr), target: "_blank" %></td>
        <td>
          <% if pr.author %>
            <%= link_to pr.author.username, "https://github.com/#{pr.author.username}", target: "_blank" %>
          <% end %>
        </td>
        <td><%= link_to pr.title, github_pr_url(pr), target: "_blank" %></td>
        <td><%= pr.state %></td>
        <td><%= pr.gh_created_at&.in_time_zone('Central Time (US & Canada)')&.strftime('%m/%d/%y %I:%M%p') %></td>
        <td><%= pr.ready_for_review_at&.in_time_zone('Central Time (US & Canada)')&.strftime('%m/%d/%y %I:%M%p') %></td>
        <% first_review = pr.valid_first_review %>
        <td>
          <% if first_review %>
            <%= first_review.submitted_at&.in_time_zone('Central Time (US & Canada)')&.strftime('%m/%d/%y %I:%M%p') %>
          <% end %>
        </td>
        <td>
          <% if pr.time_to_first_review %>
            <%= (pr.time_to_first_review / 1.hour).round(2) %> hrs
          <% end %>
        </td>
        <% approved_at = approvals[pr.id] %>
        <td>
          <% if approved_at %>
            <%= approved_at.in_time_zone('Central Time (US & Canada)').strftime('%m/%d/%y %I:%M%p') %>
          <% end %>
        </td>
        <td>
          <% if approved_at %>
            <%= WeekdayHours.weekday_hours_between(pr.ready_for_review_at, approved_at).round(2) %> hrs
          <% end %>
        </td>
        <td><%= pr.gh_merged_at&.in_time_zone('Central Time (US & Canada)')&.strftime('%m/%d/%y %I:%M%p') %></td>
        <td>
          <% if pr.weekday_hours_to_merge %>
            <%= (pr.weekday_hours_to_merge / 1.hour).round(2) %> hrs
          <% end %>
        </td>
        <td>
          <% if pr.gh_closed_at && !pr.gh_merged_at %>
            <%= pr.gh_closed_at.in_time_zone('Central Time (US & Canada)').strftime('%m/%d/%y %I:%M%p') %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
