<div class="row justify-content-center">
  <div class="col-md-6">
    <h1>Repository Access</h1>
    <p class="text-muted"><%= @user.email %> sees only the repositories checked here.</p>

    <%= form_with(model: @user, local: true) do |form| %>
      <fieldset class="mb-3">
        <legend class="form-label">Repositories</legend>
        <% if @repositories.empty? %>
          <p class="text-muted">No repositories have been added yet.</p>
        <% end %>
        <%= form.collection_check_boxes :granted_repository_ids, @repositories, :id, :name do |box| %>
          <div class="form-check">
            <%= box.check_box(class: "form-check-input") %>
            <%= box.label(class: "form-check-label") %>
          </div>
        <% end %>
      </fieldset>

      <div class="d-flex justify-content-between">
        <%= form.submit "Save access", class: "btn btn-primary" %>
        <%= link_to "Cancel", users_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
